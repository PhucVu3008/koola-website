# Frontend (Next.js)
# In Docker Compose, this is set automatically for the `web` service.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Google Analytics 4
# Format: G-XXXXXXXXXX (get from https://analytics.google.com → Admin → Data Streams → Web stream)
# Leave empty or remove to disable GA (safe for local development)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
